{{- $pages := where .Pages "Params.draft" "!=" true -}}
{{- $limit := .Site.Config.Services.RSS.Limit -}}
{{- if gt $limit 0 -}}
  {{- $pages = $pages | first $limit -}}
{{- end -}}
<rss version="2.0"
  xmlns:atom="http://www.w3.org/2005/Atom"
  xmlns:dc="http://purl.org/dc/elements/1.1/"
  xmlns:content="http://purl.org/rss/1.0/modules/content/"
  xmlns:media="http://search.yahoo.com/mrss/">
  <channel>
    <title>{{ .Title }} | {{ .Site.Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ with .Description }}{{ . }}{{ else }}{{ .Site.Params.description }}{{ end }}</description>
    <language>{{ .Site.LanguageCode }}</language>
    <lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    <generator>Hugo</generator>
    {{ with .Site.Params.author }}<dc:creator>{{ . }}</dc:creator>{{ end }}
    <atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml" />
    {{- range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <dc:creator>{{ with .Params.author }}{{ . }}{{ else }}{{ .Site.Params.author }}{{ end }}</dc:creator>
      <guid>{{ .Permalink }}</guid>
      <description>{{ .Summary | htmlUnescape | html }}</description>
      {{- with .Params.feature_image }}
      {{- $imgURL := . | absURL }}
      <enclosure url="{{ $imgURL }}" length="0" type="image/png" />
      <media:thumbnail url="{{ $imgURL }}" />
      <media:content url="{{ $imgURL }}" type="image/png" medium="image" />
      {{- end }}
      <content:encoded>{{ printf "<![CDATA[" | safeHTML }}{{ with .Params.feature_image }}<img src="{{ . | absURL }}" alt="{{ $.Title }}" style="max-width:100%;height:auto;" />{{ end }}{{ .Content | htmlUnescape | safeHTML }}{{ printf "]]>" | safeHTML }}</content:encoded>
    </item>
    {{- end }}
  </channel>
</rss>
